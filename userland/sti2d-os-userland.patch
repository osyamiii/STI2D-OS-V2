 using namespace Escher;
 using namespace Poincare;
 
+namespace Sti2d {
+bool Available();
+}
+
 namespace Home {
 
 Controller::ContentView::ContentView(
@@ -68,6 +72,13 @@ bool Controller::handleEvent(Ion::Events::Event event) {
     return true;
   }
   if (event == Ion::Events::Home || event == Ion::Events::Back) {
+    /* STI2D-OS: this grid was opened from the STI2D-OS shell; Home and Back
+     * go back to it (AppsContainer::switchToBuiltinApp runs the shell). */
+    if (Sti2d::Available()) {
+      AppsContainer::sharedAppsContainer()->switchToBuiltinApp(
+          AppsContainer::sharedAppsContainer()->homeAppSnapshot());
+      return true;
+    }
     m_view.selectableTableView()->selectCellAtLocation(0, 0);
     return true;
   }
