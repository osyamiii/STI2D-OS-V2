diff --git a/epsilon/apps/apps_container.cpp b/epsilon/apps/apps_container.cpp
index c2fe7f4016..88878e2125 100644
--- a/epsilon/apps/apps_container.cpp
+++ b/epsilon/apps/apps_container.cpp
@@ -146,6 +146,13 @@ void AppsContainer::didSuspend() {
   m_backlightDimmingTimer.reset();
   m_window.updateBatteryAnimation();
   window()->redraw(true);
+  /* STI2D-OS: with a PIN, waking up shows the lock screen, whatever app was
+   * open (the onboarding and the hardware test excepted). */
+  if (sti2dDidSuspend() && activeApp() &&
+      activeApp()->snapshot() != onBoardingAppSnapshot() &&
+      activeApp()->snapshot() != hardwareTestAppSnapshot()) {
+    switchToBuiltinApp(homeAppSnapshot());
+  }
 }
 
 bool AppsContainer::dispatchEvent(Ion::Events::Event event) {
@@ -231,7 +238,16 @@ bool AppsContainer::processEvent(Ion::Events::Event event) {
   return false;
 }
 
+namespace Sti2d {
+bool ShouldRunShell();
+}
+
 void AppsContainer::switchToBuiltinApp(App::Snapshot* snapshot) {
+  /* STI2D-OS: the home screen is the STI2D-OS shell (apps/sti2d/host.cpp),
+   * which comes back with the app to open, or with Epsilon's grid. */
+  if (snapshot == homeAppSnapshot() && Sti2d::ShouldRunShell()) {
+    snapshot = runSti2dShell();
+  }
   if (activeApp() && snapshot != activeApp()->snapshot()) {
     resetShiftAlphaStatus();
   }
@@ -313,6 +329,19 @@ void AppsContainer::run() {
   Ion::Events::setSpinner(true);
   Ion::Display::setScreenshotCallback(ShowCursor);
 
+  /* STI2D-OS: this userland is started by the official one (the other slot)
+   * through DFU. The kernel may still hold the checkpoints the official
+   * userland set, and setCheckpoint ignores a checkpoint that is already set:
+   * Home (or waking up) would then jump back into the official userland. Drop
+   * them so that this userland's own Home checkpoint is the one the kernel
+   * uses. (Same fix as the PSP-OS userland.) */
+  Ion::CircuitBreaker::unsetCheckpoint(
+      Ion::CircuitBreaker::CheckpointType::AnyKey);
+  Ion::CircuitBreaker::unsetCheckpoint(
+      Ion::CircuitBreaker::CheckpointType::Back);
+  Ion::CircuitBreaker::unsetCheckpoint(
+      Ion::CircuitBreaker::CheckpointType::Home);
+
   /* Setup the home checkpoint so that the exception checkpoint will be
    * reactivated on a home interrupt. This way, the main exception checkpoint
    * will keep the home checkpoint as parent. */
